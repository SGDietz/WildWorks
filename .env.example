# X API - required to show the latest post on the home page.
# Token must stay secret. Use only in .env.local or Vercel env, never commit.
X_BEARER_TOKEN=

# Supabase telemetry - required for visitor/session/action/transcript capture.
# Service-role key is server-only. Never expose it in client code.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TELEMETRY_BUCKET=wildworks-telemetry

# Keep all provider credentials server-only in .env.local or your host's secret store.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Optional internal notification for each completed signup.
WILDWORKS_SIGNUP_NOTIFY_EMAIL=
# Optional internal destination for voice leads and voicemail; falls back to the signup address.
WILDWORKS_VOICE_NOTIFY_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Use one of these Twilio sender options. A Messaging Service is preferred.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=

# Staged Twilio inbound voice webhooks. Do not point the live number here until
# the HTTPS callbacks, WSS agent, voicemail email, and failure paths are tested.
# Exact public HTTPS origin Twilio calls; required when hosting rewrites the request URL.
TWILIO_VOICE_PUBLIC_BASE_URL=
# ConversationRelay connects only to a secure WebSocket URL.
PUBLIC_WSS_URL=
# Twilio provides ElevenLabs TTS inside ConversationRelay; no ElevenLabs API key is used here.
TWILIO_CONVERSATION_RELAY_TTS_PROVIDER=ElevenLabs
# Required Twilio-supported ElevenLabs voice identifier for the reviewed iScott voice.
TWILIO_CONVERSATION_RELAY_VOICE=

# Shared only between the Render iScott voice service and this Vercel app.
# Use at least 32 random bytes. It must match on both services.
WILDWORKS_VOICE_EVENT_SECRET=
# Distinct 32+ byte secret used to sign short-lived recording playback links.
WILDWORKS_VOICE_PLAYBACK_SECRET=
WILDWORKS_VOICE_PLAYBACK_TTL_SECONDS=86400
# Distinct 32+ byte bearer secret used by the Render maintenance worker.
# CRON_SECRET is the independent 32+ byte secret sent by Vercel Cron; the route
# accepts either credential so the five-minute worker and daily backup both run.
WILDWORKS_VOICE_CRON_SECRET=
CRON_SECRET=
# Delay before a completed/absent recording with no transcription callback is
# treated as a clear transcription failure. Allowed range: 300-3600 seconds.
WILDWORKS_VOICE_TRANSCRIPTION_GRACE_SECONDS=900
WILDWORKS_VOICE_BACKEND_TIMEOUT_MS=2500
# Voice retention stays disabled until the migration, restricted Twilio key,
# dry run, and live deletion test are explicitly approved.
WILDWORKS_VOICE_RETENTION_ENABLED=false
WILDWORKS_VOICE_RETENTION_DRY_RUN=true
WILDWORKS_VOICE_RETENTION_BATCH_LIMIT=10
TWILIO_VOICE_RECORDINGS_API_KEY_SID=
TWILIO_VOICE_RECORDINGS_API_KEY_SECRET=
# Emergency local fallback only; production should use the restricted API key.
WILDWORKS_VOICE_RETENTION_ALLOW_ACCOUNT_AUTH=false

# LiveAvatar - WildWorks must use the iScott avatar/context, not aiASAP/6.
LIVEAVATAR_API_KEY=
LIVEAVATAR_API_URL=https://api.liveavatar.com
WILDWORKS_LIVEAVATAR_AVATAR_ID=
WILDWORKS_LIVEAVATAR_VOICE_ID=
WILDWORKS_LIVEAVATAR_CONTEXT_ID=
WILDWORKS_LIVEAVATAR_LANGUAGE=en

# Optional production API rate limits through Upstash Redis.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_PER_DAY=400
RATE_LIMIT_PER_MINUTE=60
