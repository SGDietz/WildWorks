# X API - required to show the latest post on the home page.
# Token must stay secret. Use only in .env.local or Vercel env, never commit.
X_BEARER_TOKEN=

# Supabase telemetry - required for visitor/session/action/transcript capture.
# Service-role key is server-only. Never expose it in client code.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TELEMETRY_BUCKET=wildworks-telemetry

# Keep all provider credentials server-only in .env.local or your host's secret store.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Optional internal notification for each completed signup.
WILDWORKS_SIGNUP_NOTIFY_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Use one of these Twilio sender options. A Messaging Service is preferred.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=

# LiveAvatar - WildWorks must use the iScott avatar/context, not aiASAP/6.
LIVEAVATAR_API_KEY=
LIVEAVATAR_API_URL=https://api.liveavatar.com
WILDWORKS_LIVEAVATAR_AVATAR_ID=
WILDWORKS_LIVEAVATAR_VOICE_ID=
WILDWORKS_LIVEAVATAR_CONTEXT_ID=
WILDWORKS_LIVEAVATAR_LANGUAGE=en

# Optional production API rate limits through Upstash Redis.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_PER_DAY=400
RATE_LIMIT_PER_MINUTE=60
