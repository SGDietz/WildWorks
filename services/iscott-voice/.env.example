NODE_ENV=development
HOST=0.0.0.0
PORT=10000
PUBLIC_WSS_URL=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# AI stays off until the staged Press 1/Press 2 call test passes.
AI_ENABLED=false
LLM_ENDPOINT_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=12000
LLM_MAX_TOKENS=320

CALL_MAX_SECONDS=120
CALL_MAX_MESSAGES=64
CALL_MAX_PROMPTS=10
CALL_MAX_INPUT_CHARS=12000
CALL_MAX_OUTPUT_CHARS=16000
CALL_MAX_CONTEXT_MESSAGES=12
RESPONSE_CHUNK_CHARS=120

DAILY_MAX_CALLS=3
DAILY_MAX_PROMPTS=30
DAILY_MAX_OUTPUT_CHARS=25000

# Production must use supabase. Memory is allowed only for local development/tests.
BUDGET_BACKEND=memory
BUDGET_TIMEOUT_MS=3000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUDGET_RPC=reserve_iscott_voice_daily_usage

# Authenticated durable transcript/lead events. Production requires both.
WILDWORKS_VOICE_EVENT_URL=https://www.wildworks.live/api/internal/voice-events
WILDWORKS_VOICE_EVENT_SECRET=
WILDWORKS_VOICE_EVENT_TIMEOUT_MS=1500
WILDWORKS_VOICE_EVENT_MAX_ATTEMPTS=3
WILDWORKS_VOICE_EVENT_RETRY_BASE_MS=100
WILDWORKS_VOICE_CRON_SECRET=
WILDWORKS_VOICE_MAINTENANCE_INTERVAL_SECONDS=300
WILDWORKS_VOICE_MAINTENANCE_TIMEOUT_MS=5000

SHUTDOWN_HANDOFF_GRACE_MS=1000
